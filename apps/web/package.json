{
  "name": "@enigma/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- sh -c 'next dev -p ${WEB_PORT:-3000}'",
    "build": "dotenv -e ../../.env -- sh -c 'NODE_ENV=production next build'",
    "start": "dotenv -e ../../.env -- sh -c 'NODE_ENV=production next start -p ${WEB_PORT:-3000}'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@enigma/core": "workspace:*",
    "@enigma/shared": "workspace:*",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "@enigma/provenance": "workspace:*",
    "d3-force": "^3.0.0"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "dotenv-cli": "^7.4.0"
  }
}
