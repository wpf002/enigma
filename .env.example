# --- core
NODE_ENV=development

# --- databases
# Host ports for the two Postgres containers. Change these if 5432/5433 are taken.
ENIGMA_PG_PORT=5432
AACT_PG_PORT=5433
DATABASE_URL=postgresql://enigma:enigma@localhost:5432/enigma
AACT_DATABASE_URL=postgresql://aact:aact@localhost:5433/aact

# --- services
API_PORT=4000
WEB_PORT=3000
ENGINE_PORT=8100
ENGINE_URL=http://localhost:8100
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# --- ingestion
AACT_SNAPSHOT_VERSION=
INGEST_BATCH_SIZE=1000
THERAPEUTIC_AREA=t2d-cv

# --- engine tuning (see ENIGMA_ROADMAP.md §4)
COMPARABILITY_GATE_THRESHOLD=0.70
DOSE_EQUIVALENCE_BAND=0.25
TIMEPOINT_OVERLAP_MIN_DAYS=14
HETEROGENEITY_I2_THRESHOLD=0.60
